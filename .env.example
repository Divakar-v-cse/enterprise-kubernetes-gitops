# Copy to .env for local Compose use. NEVER commit the real .env.
# Values below are local-only demo defaults.

# PostgreSQL (one instance, four databases)
POSTGRES_PASSWORD=platform

# Service-to-service authentication (all services must share this)
INTERNAL_API_TOKEN=dev-internal-token

# Storefront writes require this header: X-API-Key
PUBLIC_API_KEY=demo-public-key

# Platform dashboard bearer token
PLATFORM_API_TOKEN=platform-demo-token

# Grafana (local only)
GRAFANA_PASSWORD=admin

# Optional overrides
# APP_ENV=development
# LOG_LEVEL=INFO
# REQUEST_TIMEOUT_SECONDS=2.5
# RATE_LIMIT_PER_MINUTE=240
# NOTIFICATION_FAILURE_RATE=0
# PLATFORM_DEMO_MODE=true
