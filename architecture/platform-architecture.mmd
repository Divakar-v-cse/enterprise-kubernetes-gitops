flowchart TB
    subgraph dev["Developer workflow"]
        DEV["Developer<br/>commit + push"]
        GHA["GitHub Actions / Jenkins<br/>lint · tests · build · scan"]
        REG[("Container registry<br/>GHCR")]
    end

    subgraph git["Git — single source of truth"]
        REPO["enterprise-kubernetes-gitops<br/>apps · helm · k8s · monitoring"]
        VALUES["helm/charts/*/values.yaml<br/>image tags = desired state"]
    end

    subgraph cp["Argo CD control plane (argocd namespace)"]
        APPSET["App-of-Apps<br/>sync waves -10 → 10"]
        PROD["platform-production<br/>manual sync (approval gate)"]
    end

    subgraph k8s["Kind cluster — gitops-platform"]
        subgraph nsplatform["namespace: platform"]
            ING["NGINX Ingress<br/>:18080"]
            FE["frontend<br/>React + NGINX"]
            GW["api-gateway<br/>auth · rate limit · fan-out"]
            US["user-service"]
            PS["product-service"]
            OS["order-service<br/>saga + compensation"]
            NS["notification-service"]
            PA["platform-api<br/>read-only K8s API"]
            PG[("PostgreSQL<br/>users · products<br/>orders · notifications")]
        end
        subgraph nsmon["namespace: monitoring"]
            PROM["Prometheus"]
            AM["Alertmanager"]
            GRAF["Grafana<br/>6 dashboards"]
            KSM["kube-state-metrics"]
            NE["node-exporter"]
        end
        subgraph nslog["namespace: logging"]
            LOKI["Loki"]
            PT["Promtail DaemonSet"]
        end
        subgraph nssec["security guardrails"]
            NP["NetworkPolicies<br/>default deny"]
            RBAC["RBAC<br/>read-only SA"]
            PSS["Pod Security<br/>restricted"]
            PDB["PDBs + HPA + Quota"]
        end
    end

    DEV -->|push code| GHA
    GHA -->|build + Trivy scan| REG
    GHA -->|update image tag| VALUES
    REPO --> VALUES
    REPO -->|watch / poll| APPSET
    APPSET -->|auto-sync dev| nsplatform
